# Google Gemini API Key for automatic issue triage and priority prediction
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Existing Neon PostgreSQL connection (server only)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stable random secret, at least 32 characters. Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Same canonical origin for links, CSRF origin checks, and Auth.js.
# HTTPS is required in production.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Google OAuth client of type Web application. Redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Enable only behind a trusted proxy that validates/overwrites Host headers.
# AUTH_TRUST_HOST=true

# Real email delivery requires a verified Resend sender/domain.
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Local testing only: next dev + loopback APP_URL + AUTH_EMAIL_PROVIDER=file
# Messages appear in .auth-outbox/*.json; no email is sent.
# File delivery is rejected in production.

# Set only in an operator shell for pnpm auth:bootstrap-admin, then remove:
# BOOTSTRAP_ADMIN_EMAIL=your-existing-verified-student@campus.edu
